<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="blackjack.userinterface.MainMenuController"
            prefWidth="300" prefHeight="200"
            style="-fx-background-image: url('/images/mainmenu.jpg'); -fx-background-size: cover;">

    <VBox spacing="20" alignment="CENTER" prefWidth="300" prefHeight="200" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">
        <Button text="Play Blackjack" onMouseClicked="#playBlackjack"/>
        <Button text="Play Texas Hold'em" onMouseClicked="#playTexasHoldem"/>
    </VBox>

</AnchorPane>
