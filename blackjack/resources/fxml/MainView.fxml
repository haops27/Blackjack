<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/24"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="blackjack.userinterface.MainController">

  <!-- green table background -->
  <ImageView fx:id="tableImageView" fitWidth="900" preserveRatio="true"/>

  <AnchorPane prefWidth="900" prefHeight="600">

    <!-- dealer’s cards -->
    <HBox fx:id="dealerCardsHBox"
          layoutX="150" layoutY="80"
          prefWidth="600" prefHeight="120"
          spacing="10" alignment="CENTER"/>

    <!-- dealer sum (just above the dealer cards) -->
    <Label fx:id="dealerSumLabel"
           layoutX="350" layoutY="60"
           style="-fx-font-size:18px; -fx-text-fill:red;"
           text="Dealer Sum: 0"/>

    <!-- player’s cards -->
    <HBox fx:id="playerCardsHBox"
          layoutX="150" layoutY="360"
          prefWidth="600" prefHeight="120"
          spacing="10" alignment="CENTER"/>

    <!-- player sum (just above the player cards) -->
    <Label fx:id="playerSumLabel"
           layoutX="350" layoutY="340"
           style="-fx-font-size:18px; -fx-text-fill:red;"
           text="Player Sum: 0"/>

    <!-- chip image, hidden until after bet -->
    <ImageView fx:id="chipImageView"
               layoutX="420" layoutY="480"
               fitWidth="50" fitHeight="50"
               visible="false"/>

    <!-- tokens label -->
    <Label fx:id="tokensLabel"
           layoutX="740" layoutY="480"
           style="-fx-font-size:16px; -fx-text-fill:red;"
           text="Tokens: 2500"/>

    <!-- side bet label -->
    <Label fx:id="sideBetLabel"
           layoutX="740" layoutY="510"
           style="-fx-font-size:16px; -fx-text-fill:red;"
           text="Side Bet: 0.00"/>

    <!-- status messages over the table (transparent background) -->
    <Label fx:id="statusLabel"
           layoutX="150" layoutY="230"
           prefWidth="600" prefHeight="100"
           wrapText="true"
           style="-fx-background-color:transparent;
                  -fx-font-size:14px;
                  -fx-text-fill:gold;"/>

    <!-- bet inputs + side-bet checkboxes -->
    <HBox layoutX="150" layoutY="540"
          prefWidth="600" spacing="10" alignment="CENTER">
      <Label text="Main Bet:" style="-fx-text-fill:red;"/>
      <TextField fx:id="mainBetField" prefWidth="100"/>
      <Label text="Side Bet:" style="-fx-text-fill:red;"/>
      <TextField fx:id="sideBetField" prefWidth="100"/>
      <CheckBox fx:id="perfectPairCheckBox" text="Perfect Pair" style="-fx-text-fill:red;"/>
      <CheckBox fx:id="twentyOnePlusThreeCheckBox" text="21+3" style="-fx-text-fill:red;"/>
      <Button fx:id="insuranceButton"
              text="Take Insurance"
              disable="true"
              onAction="#onInsurance"
              style="-fx-font-size:12px; -fx-text-fill:orange;"/>
    </HBox>

    <!-- action buttons -->
    <HBox layoutX="150" layoutY="580"
          prefWidth="600" spacing="10" alignment="CENTER">
      <Button fx:id="placeBetButton" text="Place Bet" onAction="#onPlaceBet"/>
      <Button fx:id="hitButton"       text="Hit"       disable="true" onAction="#onHit"/>
      <Button fx:id="standButton"     text="Stand"     disable="true" onAction="#onStand"/>
      <Button fx:id="doubleButton"    text="Double"    disable="true" onAction="#onDouble"/>
      <Button fx:id="splitButton"     text="Split"     disable="true" onAction="#onSplit"/>
      <Button fx:id="newRoundButton"  text="New Round" disable="true" onAction="#onNewRound"/>
    </HBox>

  </AnchorPane>
</StackPane>
