<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="blackjack.userinterface.MainController">
    <children>

        <!-- green table background -->
        <ImageView fx:id="tableImageView" fitWidth="900" preserveRatio="true" />

        <AnchorPane prefHeight="600" prefWidth="900">
            <children>

                <!-- Dealer’s cards -->
                <HBox fx:id="dealerCardsHBox" alignment="CENTER" layoutX="150" layoutY="80" prefHeight="120" prefWidth="600" spacing="10" />

                <!-- Dealer sum label -->
                <Label fx:id="dealerSumLabel" layoutX="350" layoutY="60" style="-fx-font-size:18px; -fx-text-fill:red;" text="Dealer Sum: 0" />

                <!-- Two hands shown when split -->
                <HBox fx:id="playerHandsContainer" alignment="CENTER" layoutY="360.0" prefHeight="120.0" prefWidth="900.0" spacing="30.0">
                    <children>
                        <HBox fx:id="hand1HBox" alignment="CENTER" spacing="10.0">
                     <children>
                        <ImageView fitHeight="100.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true" />
                        <ImageView fitHeight="100.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true" />
                     </children></HBox>
                        <HBox fx:id="hand2HBox" alignment="CENTER" spacing="10.0" visible="false">
                     <children>
                        <ImageView fitHeight="100.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true" />
                        <ImageView fitHeight="100.0" fitWidth="70.0" pickOnBounds="true" preserveRatio="true" />
                     </children></HBox>
                    </children>
                </HBox>

                <!-- Player sum label -->
                <Label fx:id="playerSumLabel" layoutX="350" layoutY="340" style="-fx-font-size:18px; -fx-text-fill:red;" text="Player Sum: 0" />

                <!-- Chip image -->
                <ImageView fx:id="chipImageView" fitHeight="50" fitWidth="50" layoutX="420" layoutY="480" visible="false" />

                <!-- Token and side bet labels -->
                <Label fx:id="tokensLabel" layoutX="740" layoutY="480" style="-fx-font-size:16px; -fx-text-fill:red;" text="Tokens: 2500" />
                <Label fx:id="sideBetLabel" layoutX="740" layoutY="510" style="-fx-font-size:16px; -fx-text-fill:red;" text="Side Bet: 0.00" />

                <!-- Status text -->
                <Label fx:id="statusLabel" layoutX="150" layoutY="230" prefHeight="100" prefWidth="600" style="-fx-background-color:transparent; -fx-font-size:14px; -fx-text-fill:gold;" wrapText="true" />

                <!-- Betting controls -->
                <HBox alignment="CENTER" layoutX="150" layoutY="540" prefWidth="600" spacing="10">
                    <children>
                        <Label style="-fx-text-fill:red;" text="Main Bet:" />
                        <TextField fx:id="mainBetField" prefWidth="100" />
                        <Label style="-fx-text-fill:red;" text="Side Bet:" />
                        <TextField fx:id="sideBetField" prefWidth="100" />
                        <CheckBox fx:id="perfectPairCheckBox" style="-fx-text-fill:red;" text="Perfect Pair" />
                        <CheckBox fx:id="twentyOnePlusThreeCheckBox" style="-fx-text-fill:red;" text="21+3" />
                        <Button fx:id="insuranceButton" disable="true" onAction="#onInsurance" style="-fx-font-size:12px; -fx-text-fill:orange;" text="Take Insurance" />
                    </children>
                </HBox>

                <!-- Action buttons -->
                <HBox alignment="CENTER" layoutX="150" layoutY="580" prefWidth="600" spacing="10">
                    <children>
                        <Button fx:id="placeBetButton" onAction="#onPlaceBet" text="Place Bet" />
                        <Button fx:id="hitButton" disable="true" onAction="#onHit" text="Hit" />
                        <Button fx:id="standButton" disable="true" onAction="#onStand" text="Stand" />
                        <Button fx:id="doubleButton" disable="true" onAction="#onDouble" text="Double" />
                        <Button fx:id="splitButton" disable="true" onAction="#onSplit" text="Split" />
                        <Button fx:id="newRoundButton" disable="true" onAction="#onNewRound" text="New Round" />
                    </children>
                </HBox>
            </children>
        </AnchorPane>
    </children>
</StackPane>
