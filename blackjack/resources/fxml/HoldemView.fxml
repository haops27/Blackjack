<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="texas.userinterface.HoldemController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-image: url('/images/background.jpg'); -fx-background-size: cover;">

    <!-- Community cards -->
    <HBox fx:id="communityCardsHBox" layoutX="150" layoutY="100" prefWidth="600" prefHeight="120" spacing="10" alignment="CENTER" />

    <!-- Player cards -->
    <HBox fx:id="playerCardsHBox" layoutX="150" layoutY="350" prefWidth="600" prefHeight="120" spacing="10" alignment="CENTER" />

    <!-- Player name and tokens + chip -->
    <HBox layoutX="150" layoutY="480" spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="playerNameLabel" style="-fx-font-size:18px; -fx-text-fill:red;" />
        <ImageView fx:id="chipImageView" fitWidth="24" fitHeight="24" visible="false" />
        <Label fx:id="tokensLabel" style="-fx-font-size:18px; -fx-text-fill:red;" />
    </HBox>

    <Label fx:id="potLabel" layoutX="500" layoutY="480" style="-fx-font-size:18px; -fx-text-fill:red;" />
    <Label fx:id="currentBetLabel" layoutX="650" layoutY="480" style="-fx-font-size:18px; -fx-text-fill:red;" />

    <!-- Status -->
    <TextArea fx:id="statusLabel" layoutX="150" layoutY="520" prefWidth="600" prefHeight="50"
              style="-fx-font-size:16px; -fx-text-fill:gold;" wrapText="true" editable="false" />

    <!-- Action buttons -->
    <HBox layoutX="150" layoutY="580" spacing="10" alignment="CENTER">
        <Button fx:id="checkCallButton" text="Check/Call" onAction="#onCheckCall"/>
        <Button fx:id="raiseButton" text="Raise" onAction="#onRaise"/>
        <Button fx:id="foldButton" text="Fold" onAction="#onFold"/>
        <TextField fx:id="raiseAmountField" promptText="Amount" prefWidth="100"/>
        <Button fx:id="nextStageButton" onAction="#onNextStage" text="Next Stage"/>
        <Button fx:id="resetButton" text="Reset" onAction="#onReset" visible="false" disable="true"/>
    </HBox>

</AnchorPane>
