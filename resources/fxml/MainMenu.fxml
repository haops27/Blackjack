<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="200" prefWidth="300" style="-fx-background-image: url(/blackjack/resources/images/mainmenu.jpg); -fx-background-size: cover;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="blackjack.userinterface.MainMenuController">

    <VBox alignment="CENTER" prefHeight="200" prefWidth="300" spacing="20" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <Button onMouseClicked="#playBlackjack" text="Play Blackjack" />
        <Button onMouseClicked="#playTexasHoldem" text="Play Texas Hold'em" />
    </VBox>

</AnchorPane>
